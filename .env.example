# Leave blank in development to use http://localhost:8080.
API_URL=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@famoacademy.ir
SMTP_FROM_NAME="Famo Academy"

SMS_API_KEY=
