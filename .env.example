DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

JWT_SECRET=famo-jwt-secret-change-in-production
JWT_TTL=86400

CORS_ORIGINS=http://localhost:3000,http://localhost:8000

UPLOADS_PATH=./uploads
UPLOAD_MAX_SIZE=10485760

APP_ENV=development
APP_DEBUG=true

# Environment mode: development | production
