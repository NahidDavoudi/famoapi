DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

JWT_SECRET=famo-jwt-secret-change-in-production
JWT_TTL=86400
JWT_COOKIE_NAME=famo_jwt
# Leave blank to infer .famoacademy.ir/Secure in production and host-only on localhost.
JWT_COOKIE_DOMAIN=
JWT_COOKIE_SECURE=
# Leave blank for Lax normally and None for localhost frontends calling production API.
JWT_COOKIE_SAMESITE=

# External Telegram bot host. Required: service key for /api/v1/bot/* routes.
# Optional: comma-separated IP allow-list (blank = allow any IP).
BOT_SERVICE_KEY=
BOT_IP_ALLOWLIST=
# Outbox: delivery retries, stale-lock reclaim, and per-(supporter,student)
# notification de-duplication window (seconds).
BOT_OUTBOX_MAX_ATTEMPTS=3
BOT_OUTBOX_RETRY_BACKOFF=60
BOT_OUTBOX_LOCK_TTL=300
BOT_REPORT_NOTIFY_WINDOW=300
# Max broadcast recipients per supporter per Iran day.
BOT_BROADCAST_DAILY_LIMIT=200

# Admin user ids allowed to read message content (comma-separated).
# Empty = content reading disabled for everyone (stats-only remains available).
ADMIN_CONTENT_READER_IDS=

CORS_ORIGINS=https://famoacademy.ir,https://admin.famoacademy.ir,https://dash.famoacademy.ir,https://auth.famoacademy.ir,http://localhost

CACHE_ENABLED=true

UPLOADS_PATH=./uploads
UPLOAD_MAX_SIZE=10485760

APP_ENV=development
APP_DEBUG=true

# Environment mode: development | production
APP_MODE=development
# Base URL that serves the shared frontend assets (shared/css, shared/js, shared/images).
# Shared assets are served from the fixed assets domain.
ASSET_URL=
# API origin (no /api/v1).
API_URL=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@famoacademy.ir
SMTP_FROM_NAME="Famo Academy"

SMS_API_KEY=
SMS_SENDER=100001

MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_PATTERN_BODY_ID=

# --- Telegram Login (widget) ---
# Derived from the bot token: php -r "echo hash('sha256', '<BOT_TOKEN>');"
TELEGRAM_LOGIN_SECRET_KEY=
TELEGRAM_LOGIN_MAX_AGE=300
TELEGRAM_AUTH_TICKET_TTL=600
TELEGRAM_BOT_URL=
# --- Trusted proxy / client IP ---
TRUSTED_PROXIES=
TRUSTED_PROXY_HEADER=
# --- Auth throttling ---
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_LOCKOUT_SECONDS=900
AUTH_LOGIN_IP_MAX_ATTEMPTS=30
AUTH_LOGIN_USER_SOFT_MAX=20
AUTH_2FA_MAX_ATTEMPTS=5
AUTH_2FA_CHALLENGE_TTL=300
AUTH_SMS_PHONE_HOURLY_MAX=5
AUTH_SMS_IP_HOURLY_MAX=20
AUTH_TELEGRAM_VERIFY_PER_IP=30
AUTH_TELEGRAM_VERIFY_PER_TG=10
AUTH_TELEGRAM_REGISTER_PER_IP=10
AUTH_TELEGRAM_REGISTER_PER_TG=10
