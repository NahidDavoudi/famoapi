#!/usr/bin/env bash

zero="0000000000000000000000000000000000000000"
files=""

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # branch deletion

  if [ "$remote_ref" = "refs/heads/main" ] && [ -z "$ALLOW_MAIN" ]; then
    echo "ERROR: direct push to main is blocked. Use a branch + PR."
    echo "       (emergency override: ALLOW_MAIN=1 git push)"
    exit 1
  fi

  # new branch: compare against origin/main; existing branch: compare against remote tip
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
  else
    base="$remote_sha"
  fi

  if [ -n "$base" ]; then
    files+=$'\n'$(git diff --name-only --diff-filter=ACMR "$base" "$local_sha" -- '*.php')
  else
    files+=$'\n'$(git ls-tree -r --name-only "$local_sha" | grep '\.php$')
  fi
done

fail=0
count=0
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in vendor/*) continue ;; esac
  [ -f "$f" ] || continue
  count=$((count + 1))
  out=$(php -l "$f" 2>&1) || { echo "$out"; fail=1; }
done < <(printf '%s\n' "$files" | sort -u)

if [ $fail -ne 0 ]; then
  echo "ERROR: PHP syntax error, push aborted."
  exit 1
fi
echo "OK: $count PHP file(s) checked."